{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "时间序列多序列折线 + 总量面积衬底：format.parse 解析日期、time 比例尺、from.facet 分组、末端文字标注",
  "width": 720,
  "height": 360,
  "padding": { "left": 8, "top": 8, "right": 64, "bottom": 8 },

  "title": {
    "text": "五大科技股走势（2000–2010）：折线 + 总量面积衬底",
    "fontSize": 14
  },

  "data": [
    {
      "name": "stocks",
      "url": "../../assets/data/stocks.csv",
      "format": { "type": "csv", "parse": { "date": "date", "price": "number" } }
    },
    {
      "name": "total",
      "source": "stocks",
      "comment": "aggregate 只对每个日期实际存在的行求和：GOOG 2004-08 才上市，不过滤的话合计会在那个月凭空跳升 63%（158.66 → 258.40），把成分变化画成行情。所以同时算 count，再 filter 只留五只齐备的 68 个日期。",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["date"],
          "ops": ["sum", "count"],
          "fields": ["price", null],
          "as": ["total_price", "n"]
        },
        { "type": "filter", "expr": "datum.n === 5" }
      ]
    },
    {
      "name": "gate",
      "source": "total",
      "comment": "面积起点（五只齐备的第一个日期），用来放一条注记 —— 从数据里算出来，删掉上面的 filter 时注记会自动跟着走。",
      "transform": [
        {
          "type": "aggregate",
          "ops": ["min"],
          "fields": ["date"],
          "as": ["start"]
        }
      ]
    },
    {
      "name": "endpoints",
      "source": "stocks",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["symbol"],
          "ops": ["argmax"],
          "fields": ["date"],
          "as": ["last"]
        },
        {
          "type": "formula",
          "as": "dy",
          "expr": "datum.symbol === 'AMZN' ? -8 : datum.symbol === 'IBM' ? 8 : 0"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "x",
      "type": "time",
      "domain": { "data": "stocks", "field": "date" },
      "range": "width"
    },
    {
      "name": "y",
      "type": "linear",
      "domain": { "data": "total", "field": "total_price" },
      "range": "height",
      "nice": true,
      "zero": true
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": { "data": "stocks", "field": "symbol" },
      "range": "category"
    }
  ],

  "axes": [
    { "orient": "bottom", "scale": "x", "format": "%Y", "title": "年份" },
    { "orient": "left", "scale": "y", "title": "股价（美元）", "grid": true, "gridOpacity": 0.3 }
  ],

  "legends": [
    { "stroke": "color", "title": "股票代码" }
  ],

  "marks": [
    {
      "type": "area",
      "from": { "data": "total" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "date" },
          "y": { "scale": "y", "field": "total_price" },
          "y2": { "scale": "y", "value": 0 },
          "fill": { "value": "#4e79a7" },
          "fillOpacity": { "value": 0.12 }
        }
      }
    },
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "series",
          "data": "stocks",
          "groupby": "symbol"
        }
      },
      "marks": [
        {
          "type": "line",
          "from": { "data": "series" },
          "encode": {
            "enter": {
              "x": { "scale": "x", "field": "date" },
              "y": { "scale": "y", "field": "price" },
              "stroke": { "scale": "color", "field": "symbol" },
              "strokeWidth": { "value": 2 }
            },
            "update": {
              "strokeOpacity": { "value": 1 }
            },
            "hover": {
              "strokeOpacity": { "value": 0.4 }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "from": { "data": "endpoints" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "last.date", "offset": 8 },
          "y": { "scale": "y", "field": "last.price" },
          "dy": { "field": "dy" },
          "text": { "field": "symbol" },
          "fill": { "scale": "color", "field": "symbol" },
          "baseline": { "value": "middle" },
          "fontWeight": { "value": "bold" }
        }
      }
    },
    {
      "type": "rule",
      "from": { "data": "gate" },
      "comment": "面积左端的竖向注记线：标出合计口径从 4 只变成 5 只的那个月。",
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "start" },
          "y": { "value": 0 },
          "y2": { "signal": "height" },
          "stroke": { "value": "#888888" },
          "strokeDash": { "value": [3, 3] }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "gate" },
      "comment": "注记文字：让“面积为什么从中间才开始”写在图上，而不是只写在 README 里。",
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "start", "offset": 4 },
          "y": { "value": 4 },
          "text": { "value": "← GOOG 2004-08 才上市，此前不足五只，合计不画" },
          "fill": { "value": "#666666" },
          "fontSize": { "value": 10 },
          "baseline": { "value": "top" }
        }
      }
    }
  ],

  "config": {
    "axis": { "labelFontSize": 11 }
  }
}
