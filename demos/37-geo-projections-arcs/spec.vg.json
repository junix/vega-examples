      "interactive": false,
      "encode": {
        "update": {
          "x": { "field": "x" },
          "y": { "field": "y" },
          "dy": { "signal": "-(sqrt(scale('hub', datum.total) / PI) + 4)" },
          "text": { "field": "iata" },
          "align": { "value": "center" },
          "baseline": { "value": "bottom" },
          "fontSize": { "value": 10 },
          "fontWeight": { "value": "bold" },
          "fill": { "value": "#333333" }
        }
      }
    },
