          }
        },
        "update": {
          "x": { "field": "x" },
          "y": { "field": "y" },
          "size": { "scale": "hub", "field": "total" },
          "fill": { "value": "#f58518" },
          "fillOpacity": { "value": 0.75 },
          "stroke": { "value": "#8a4600" },
          "strokeWidth": { "value": 0.6 }
        },
        "hover": { "fill": { "value": "#e45756" }, "fillOpacity": { "value": 1 } }
      }
    },
    {
      "type": "text",
